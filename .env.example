# Supabase Credentials (Public client read-only)
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase Service Role Key (SERVER-SIDE ONLY - NEVER EXPOSE TO CLIENT)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Diyoration Admin Authentication (SERVER-SIDE ONLY)
ADMIN_USERNAME=diyoration
ADMIN_PASSWORD_HASH=your_bcrypt_or_pbkdf2_hash_here
ADMIN_SESSION_SECRET=your_long_random_64_character_session_secret_here
