# Supabase Credentials (Public client read-only)
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase Service Role Key (SERVER-SIDE ONLY - NEVER EXPOSE TO BROWSER / CLIENT)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Card Encryption Key (SERVER-SIDE ONLY - 32-byte secret for AES-256-GCM bank card encryption)
# Generate with: openssl rand -hex 32
CARD_ENCRYPTION_KEY=your_64_hex_character_or_32_byte_secret_here
