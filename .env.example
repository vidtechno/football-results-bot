# Supabase Credentials (Public client + Secret service role key for cron/API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# API-Football (API-Sports) credentials
API_FOOTBALL_KEY=your_api_football_key_here
API_FOOTBALL_BASE_URL=https://v3.football.api-sports.io

# Secret key to authorize Vercel Cron or external trigger requests
CRON_SECRET=your_cron_secret_token_here
